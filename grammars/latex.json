{
  "name": "LaTeX",
  "scopeName": "text.tex.latex",
  "type": "tree-sitter",
  "parser": "tree-sitter-latex",
  "injectionNames": ["latex", "tex"],
  "firstLineRegex": ["\\\\document(class|style)"],
  "fileTypes": ["tex", "ltx", "sty", "cls", "dtx", "ins", "tikz", "bbx", "cbx", "lco"],
  "comments": {
    "start": "% "
  },
  "treeSitter": {
    "parserSource": "github:latex-lsp/tree-sitter-latex#fa8df448fc2c0192a8c2f8cfc97de53cb2b4ecb9",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "latex.wasm",
    "highlightsQuery": "latex-highlights.scm",
    "foldsQuery": "latex-folds.scm",
    "indentsQuery": "latex-indents.scm",
    "tagsQuery": "latex-tags.scm",
    "injectionsQuery": "latex-injections.scm"
  }
}
