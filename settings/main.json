{
  ".text.tex.latex": {
    "autocomplete": {
      "extraWordCharacters": "\\"
    },
    "editor": {
      "commentStart": "% ",
      "completions": [
        "corollary",
        "definition",
        "description",
        "enumerate",
        "equation",
        "itemize",
        "lemma",
        "proof",
        "proposition",
        "verbatim"
      ],
      "softWrap": true
    }
  }
}
